NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# Leave empty in development to auto-start a local MongoDB (data in server/.mongo-data)
# Production / Atlas example: mongodb+srv://user:pass@cluster.mongodb.net/whatsapp_crm
MONGO_URI=
# Optional: a DB read that stalls longer than this is retried on a fresh connection (ms), and pooled
# connections idle longer than DB_MAX_IDLE_MS are not reused (helps on networks that drop idle TCP connections)
# DB_SOCKET_TIMEOUT_MS=4000
# DB_MAX_IDLE_MS=15000

JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=7d
# 64 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# WhatsApp Cloud API (Meta App level)
WA_GRAPH_VERSION=v21.0
WA_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=change-me-verify-token

# Bulk sending speed
CAMPAIGN_MPS=10
CAMPAIGN_WORKER_INTERVAL_MS=2000

# Seed credentials (npm run seed)
SEED_SUPERADMIN_EMAIL=superadmin@crm.local
SEED_SUPERADMIN_PASSWORD=SuperAdmin@123
SEED_DEMO_PASSWORD=Demo@1234
# Graph version used only for the chatbot's "typing…" indicator (needs a recent one)
WA_TYPING_GRAPH_VERSION=v23.0
# Login attempts allowed per IP in 15 minutes
LOGIN_RATE_LIMIT=20

# ---------- File storage (chat photos / PDFs) ----------
# local = server/uploads (development only: Render wipes it on every deploy)
# cloudinary = fill the 3 keys from https://console.cloudinary.com (Settings -> API Keys)
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder inside your Cloudinary account (one sub-folder per business is added automatically)
CLOUDINARY_FOLDER=whatsapp-crm
# If Cloudinary fails, chat files wait on this server's disk and upload again by themselves.
# The admin is alerted (web bell + phone) when this many files / MB are waiting (Settings → Files on server disk).
DISK_ALERT_FILES=100
DISK_ALERT_MB=500

# Instagram channel database change (chats get a channel, a lead may have no phone).
# Runs by itself on a local database. On production: take a backup, then set to "run" once and restart.
CHANNEL_MIGRATION=

# ---------- Instagram DMs (Meta App → Instagram product → "API setup with Instagram login") ----------
# (INSTAGRAM_APP_ID / INSTAGRAM_APP_SECRET also work)
IG_APP_ID=
# Leave empty when Instagram is in the same Meta App as WhatsApp (WA_APP_SECRET is used)
IG_APP_SECRET=
# Any secret word; type the same word in the App Dashboard webhook settings (callback: <PUBLIC_URL>/api/webhook/instagram)
IG_WEBHOOK_VERIFY_TOKEN=
# Exactly as registered in the App Dashboard, e.g. https://api.example.com/api/instagram/callback
IG_REDIRECT_URL=
IG_GRAPH_VERSION=v25.0
# This API's public https address (Instagram downloads the files we send from here)
PUBLIC_URL=

# Shown on the public /privacy and /data-deletion pages (Meta asks for both)
LEGAL_COMPANY=
LEGAL_CONTACT_EMAIL=

# ---------- Facebook Page posts + comments (Meta App → Facebook Login for Business) ----------
# The Meta App id (App Dashboard, top left) — not the Instagram app id
FB_APP_ID=
# Leave empty to use WA_APP_SECRET (same Meta App)
FB_APP_SECRET=
# Facebook Login for Business → Configurations → the configuration's id
FB_LOGIN_CONFIG_ID=
# Exactly as in Facebook Login → Valid OAuth Redirect URIs, e.g. https://api.example.com/api/facebook/callback
FB_REDIRECT_URL=
# Webhooks → Page → verify token (empty = same as IG_WEBHOOK_VERIFY_TOKEN). Callback: <PUBLIC_URL>/api/webhook/facebook
FB_WEBHOOK_VERIFY_TOKEN=
