NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# Leave empty in development to auto-start a local MongoDB (data in server/.mongo-data)
# Production / Atlas example: mongodb+srv://user:pass@cluster.mongodb.net/whatsapp_crm
MONGO_URI=

JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=7d
# 64 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# WhatsApp Cloud API (Meta App level)
WA_GRAPH_VERSION=v21.0
WA_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=change-me-verify-token

# Bulk sending speed
CAMPAIGN_MPS=10
CAMPAIGN_WORKER_INTERVAL_MS=2000

# Seed credentials (npm run seed)
SEED_SUPERADMIN_EMAIL=superadmin@crm.local
SEED_SUPERADMIN_PASSWORD=SuperAdmin@123
SEED_DEMO_PASSWORD=Demo@1234
