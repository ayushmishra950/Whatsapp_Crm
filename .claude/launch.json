{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "MONGO_URI=",
        "npm",
        "--prefix",
        "server",
        "run",
        "dev"
      ],
      "port": 4000
    }
  ]
}